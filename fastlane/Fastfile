require "shellwords"

# 우리의 공간 (Capacitor iOS) 배포 자동화
#   fastlane ios check    키 연결 확인 (빌드 없음, 1분 이내)
#   fastlane ios beta     웹 빌드 → iOS 동기화 → 서명·빌드 → TestFlight 업로드
#   fastlane ios release  위와 같지만 App Store 심사용으로 업로드 (심사 제출은 직접)
#
# 주의: 레인 안의 Ruby 코드와 sh 는 fastlane/ 폴더에서, 액션은 프로젝트 루트에서 실행됩니다.

default_platform(:ios)

ROOT    = File.expand_path("..", __dir__)
PROJECT = "ios/App/App.xcodeproj"
SCHEME  = "App"
TEAM_ID = "79978S7426"

platform :ios do
  private_lane :asc_key do
    key_id = ENV["ASC_KEY_ID"].to_s
    issuer = ENV["ASC_ISSUER_ID"].to_s
    UI.user_error!("fastlane/.env 에 ASC_KEY_ID 와 ASC_ISSUER_ID 를 넣어 주세요 (.env.example 참고)") if key_id.empty? || issuer.empty?

    path = ENV["ASC_KEY_PATH"].to_s
    path = "~/.appstore-keys/AuthKey_#{key_id}.p8" if path.empty?
    path = File.expand_path(path)
    UI.user_error!("키 파일이 없습니다: #{path}") unless File.exist?(path)

    app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_filepath: path, duration: 1200)
    { key_id: key_id, issuer: issuer, path: path }
  end

  private_lane :prepare_web do
    Dir.chdir(ROOT) do
      %w[privacy.html terms.html].each do |f|
        UI.user_error!("#{f} 가 없습니다. vite build 에 필요한 파일이 저장소에 모두 있는지 확인하세요.") unless File.exist?(f)
      end
      sh("npm", "ci") unless File.directory?("node_modules")
      sh("npm", "run", "build")
      sh("npx", "cap", "add", "ios") unless File.directory?("ios")
      sh("npx", "cap", "sync", "ios")
      sh("node", "scripts/configure-ios.cjs") if File.exist?("scripts/configure-ios.cjs")
    end
  end

  private_lane :build_signed do |options|
    key = options[:key]
    # 기존 규칙 유지: YYYYMMDD + 2자리 순번 (예: 2026111403)
    latest = latest_testflight_build_number(initial_build_number: 0).to_i
    today = Time.now.strftime("%Y%m%d")
    build = latest.to_s.start_with?(today) ? latest + 1 : "#{today}01".to_i
    UI.message("빌드 번호: #{build}")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "CoupleDiary.ipa",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key[:path].shellescape}",
        "-authenticationKeyID #{key[:key_id]}",
        "-authenticationKeyIssuerID #{key[:issuer]}",
        "CURRENT_PROJECT_VERSION=#{build}",
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "CODE_SIGN_STYLE=Automatic"
      ].join(" "),
      export_options: { teamID: TEAM_ID, signingStyle: "automatic" }
    )
  end

  desc "App Store Connect 키가 제대로 연결됐는지 확인"
  lane :check do
    asc_key
    n = latest_testflight_build_number(initial_build_number: 0)
    UI.success("연결 성공 — TestFlight 최신 빌드 번호: #{n}")
  end

  desc "TestFlight 에 업로드"
  lane :beta do
    key = asc_key
    prepare_web
    build_signed(key: key)
    upload_to_testflight(skip_waiting_for_build_processing: true)
    UI.success("TestFlight 업로드 완료. 처리에 10~30분 걸립니다.")
  end

  desc "App Store 심사용 업로드 (심사 제출은 App Store Connect 에서 직접)"
  lane :release do
    config = File.read(File.join(ROOT, "native-config.js"))
    if config =~ /testAds:\s*true/
      UI.user_error!("native-config.js 의 testAds 가 true 입니다. 실제 광고 승인 후 false 로 바꾸고 다시 실행하세요.")
    end
    key = asc_key
    prepare_web
    build_signed(key: key)
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
    UI.success("App Store Connect 에 업로드 완료. 심사 제출은 직접 눌러 주세요.")
  end
end
