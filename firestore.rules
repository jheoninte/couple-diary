rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid)); }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function member(c) { return signedIn() && (c.user1 == request.auth.uid || c.user2 == request.auth.uid); }
    function active(c, cid) {
      return member(c) && c.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == cid;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow list, write: if false;
      match /archives/{cid} { allow read: if owns(uid); allow write: if false; }
    }
    match /couples/{cid} {
      // No client writes: the callable validates authorship, revisions and membership.
      allow get: if member(resource.data) && (resource.data.get('status', '') == 'closed'
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == cid);
      allow list, write: if false;
      match /entries/{entryId} {
        function couple() { return get(/databases/$(database)/documents/couples/$(cid)).data; }
        allow read: if couple().schemaVersion == 2 && (active(couple(), cid)
          || (member(couple()) && couple().status == 'closed' && resource.data.author == request.auth.uid));
        allow write: if false;
      }
      // Storage rules need to read the reservation when uploading a photo.
      match /photoReservations/{filename} {
        allow get: if signedIn() && resource.data.uid == request.auth.uid
          && active(get(/databases/$(database)/documents/couples/$(cid)).data, cid);
        allow list, write: if false;
      }
    }
    // Invitation codes and original migration backups are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
